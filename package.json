{
  "name": "pokemon-colleja-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Simulador de combates de Pokémon Champions para practicar individuales y dobles contra un bot.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "postinstall": "tsx tools/setup/src/setup-showdown.ts",
    "setup": "tsx tools/setup/src/setup-showdown.ts",
    "setup:force": "tsx tools/setup/src/setup-showdown.ts --force",
    "smoke": "tsx tools/smoke/src/run.ts",
    "data:build": "tsx tools/data-pipeline/src/build.ts",
    "data:sprites": "tsx tools/data-pipeline/src/sprites.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm test && npm run smoke"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
